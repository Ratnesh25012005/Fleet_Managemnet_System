# ==============================================================================
# Fleet Management System - Environment Configuration Template (.env.example)
# Copy this file to .env and configure your personal credentials and API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8+)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/fleet_management_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&autoReconnect=true
DB_USERNAME=root
DB_PASSWORD=savy1234
DB_DRIVER=com.mysql.cj.jdbc.Driver

# ------------------------------------------------------------------------------
# 2. GOOGLE MAPS PLATFORM API
# Get your API key from: https://console.cloud.google.com/
# Required APIs to enable:
#   - Maps JavaScript API
#   - Maps Embed API
#   - Directions API
#   - Places API (New)
# If left blank, the app runs cleanly on the high-speed local vector & Esri dark canvas engine.
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 3. IP GEOLOCATION REST API
# Real live external REST service: https://ip-api.com/
# Returns client IP, city, state, country, lat, lon, and ISP in JSON format.
# Requires NO credit card and NO API key.
# ------------------------------------------------------------------------------
IP_API_URL=http://ip-api.com/json/

# ------------------------------------------------------------------------------
# 4. OPENAI API (Optional AI Customer Service Bot)
# Get your API key from: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL NOTIFICATION SERVICE (Optional)
# For automated booking confirmation and password reset emails.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL_ACCOUNT=your-email@gmail.com
SMTP_EMAIL_PASSWORD=your-app-password
